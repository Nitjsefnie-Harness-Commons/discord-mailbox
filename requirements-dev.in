# The CI toolchain, each tool pinned so a release cannot turn CI red on an
# unchanged commit: pycodestyle and pylint for lint.yml, pyright for
# types.yml, coverage for the coverage job in tests.yml, zizmor for
# actionlint.yml, and pip-audit for audit.yml, which audits this lock too.
#
# requirements-dev.txt is this file compiled with every transitive pin and
# its hashes; CI installs it with --require-hashes. Regenerate it on Python
# 3.11 with `pip-compile --generate-hashes requirements-dev.in`: Dependabot
# compiles the sources in this directory on the lowest Python that
# pyproject.toml's requires-python admits, so a lock compiled on any other
# interpreter is rewritten by its next update.
#
# pip, which pip-api needs, stays out of the lock: the runner's pip
# satisfies it, so installing the auditor never replaces the installer.
# requirements-build.in is a pair of its own for that reason: it compiles
# with --allow-unsafe to pin setuptools, which here would pin pip too.
#
# The suites need nothing past the package's runtime dependencies: they are
# stdlib unittest driven by run_tests.py, with no pytest.
pycodestyle==2.15.0
pylint==4.1.3
pyright==1.1.414
coverage==7.17.3
zizmor==1.32.0
pip-audit==2.10.1
